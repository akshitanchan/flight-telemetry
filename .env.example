# ===========================================================
# Flight Telemetry Intelligence Platform — Environment Template
# ===========================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.

# --- OpenSky Network (live API, OAuth2 client-credentials) ---
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- NOAA Aviation Weather (no key required) ---
# NOAA_BASE_URL=https://aviationweather.gov/api

# --- Databricks Free Edition ---
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# --- BigQuery / dbt ---
BIGQUERY_PROJECT=
BIGQUERY_DATASET=flight_telemetry
GOOGLE_APPLICATION_CREDENTIALS=

# --- Snowflake / dbt ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- AI Layer ---
OPENAI_API_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_HOST=

# --- Postgres / PostGIS (C2 contract) ---
# Placeholder only. Override in .env with real credentials. Never commit .env.
DATABASE_URL=postgresql://flight:flight@localhost:5432/flight

# --- General ---
LOG_LEVEL=INFO
DATA_DIR=./data/raw
