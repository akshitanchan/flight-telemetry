# ===========================================================
# Flight Telemetry Intelligence Platform — Environment Template
# ===========================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.

# --- OpenSky Network (live API, OAuth2 client-credentials) ---
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- NOAA Aviation Weather (no key required) ---
# NOAA_BASE_URL=https://aviationweather.gov/api

# --- Databricks Free Edition ---
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# --- BigQuery / dbt ---
BIGQUERY_PROJECT=
BIGQUERY_DATASET=flight_telemetry
GOOGLE_APPLICATION_CREDENTIALS=

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- AI Layer ---
OPENAI_API_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_HOST=

# --- General ---
LOG_LEVEL=INFO
DATA_DIR=./data/raw
