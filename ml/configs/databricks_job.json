{
  "name": "flight-telemetry-ml-fullscale-prc2025",
  "tasks": [
    {
      "task_key": "fullscale_train",
      "description": "Resumable feature extraction and full-scale FuelBurnMLP training on all 11,037 PRC-2025 training flights.",
      "spark_python_task": {
        "python_file": "ml/train_fullscale.py",
        "source": "GIT",
        "parameters": [
          "--config",
          "ml/configs/fullscale.yaml",
          "--override",
          "data.data_dir=/Volumes/main/default/flight_telemetry/prc_2025",
          "--override",
          "data.checkpoint_dir=/Volumes/main/default/flight_telemetry/features_checkpoint_train",
          "--override",
          "mlflow.tracking_uri=databricks",
          "--override",
          "training.epochs=50",
          "--override",
          "training.batch_size=16",
          "--override",
          "training.lr=0.001",
          "--override",
          "training.device=cpu",
          "--override",
          "training.checkpoint_dir=/Volumes/main/default/flight_telemetry/training_checkpoints"
        ]
      },
      "environment_key": "default",
      "timeout_seconds": 7200,
      "max_retries": 1,
      "min_retry_interval_millis": 60000
    }
  ],
  "environments": [
    {
      "environment_key": "default",
      "spec": {
        "environment_version": "2",
        "dependencies": [
          "torch>=2.0.0",
          "mlflow>=2.10.0",
          "pandas>=2.0.0",
          "pyarrow>=14.0.0",
          "scikit-learn>=1.3.0",
          "tqdm>=4.65.0",
          "pyyaml>=6.0"
        ]
      }
    }
  ],
  "git_source": {
    "git_url": "https://github.com/akshitanchan/flight-telemetry",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "max_concurrent_runs": 1,
  "tags": {
    "project": "flight-telemetry",
    "wave": "W4.2",
    "task": "ml-05",
    "compute": "serverless"
  }
}
