{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gold_emergency_events.schema.json",
  "title": "gold_emergency_events",
  "description": "Emergency squawk event log. Records flights that triggered squawk codes 7500 (hijack), 7600 (radio failure), or 7700 (general emergency).",
  "type": "object",
  "properties": {
    "icao24": {
      "type": "string",
      "description": "24-bit transponder hex id",
      "pattern": "^[0-9a-f]{6}$"
    },
    "callsign": {
      "type": ["string", "null"],
      "description": "Flight callsign"
    },
    "squawk": {
      "type": "string",
      "description": "Emergency squawk code",
      "enum": ["7500", "7600", "7700"]
    },
    "first_seen_ts": {
      "type": "string",
      "description": "First observation of emergency squawk (ISO 8601)",
      "format": "date-time"
    },
    "last_seen_ts": {
      "type": "string",
      "description": "Last observation of emergency squawk (ISO 8601)",
      "format": "date-time"
    },
    "lat": {
      "type": "number",
      "description": "Latitude at first observation",
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": "number",
      "description": "Longitude at first observation",
      "minimum": -180,
      "maximum": 180
    },
    "origin_country": {
      "type": "string",
      "description": "Country of aircraft registration"
    },
    "nearest_airport": {
      "type": ["string", "null"],
      "description": "ICAO code of nearest airport at first observation"
    },
    "duration_s": {
      "type": "integer",
      "description": "Duration of emergency squawk in seconds",
      "minimum": 0
    }
  },
  "required": [
    "icao24",
    "squawk",
    "first_seen_ts",
    "last_seen_ts",
    "lat",
    "lon",
    "origin_country",
    "duration_s"
  ],
  "additionalProperties": false,
  "_contract_version": "1.0.0"
}
