{
  "name": "flight_telemetry_medallion_pipeline",
  "tasks": [
    {
      "task_key": "bronze_to_silver",
      "description": "Read bronze JSONL from a UC Volume, apply the C1 transform, and write silver Delta.",
      "notebook_task": {
        "notebook_path": "data/cloud/databricks/notebooks/01_bronze_to_silver",
        "base_parameters": {
          "bronze_volume_path": "/Volumes/main/default/flight_telemetry/bronze/flight_state/",
          "silver_table": "main.default.silver_flight_state",
          "airports_ref_path": "/Volumes/main/default/flight_telemetry/reference/airports.json"
        },
        "source": "GIT"
      },
      "environment_key": "default",
      "timeout_seconds": 3600,
      "max_retries": 1,
      "min_retry_interval_millis": 60000
    },
    {
      "task_key": "silver_to_gold",
      "description": "Build all four C3 gold Delta tables from silver.",
      "depends_on": [
        {
          "task_key": "bronze_to_silver"
        }
      ],
      "notebook_task": {
        "notebook_path": "data/cloud/databricks/notebooks/02_silver_to_gold",
        "base_parameters": {
          "silver_table": "main.default.silver_flight_state",
          "gold_emergency_table": "main.default.gold_emergency_events",
          "gold_sector_table": "main.default.gold_sector_load",
          "gold_congestion_table": "main.default.gold_airport_congestion",
          "gold_routing_table": "main.default.gold_routing_stats",
          "incremental_window_start": "",
          "incremental_window_end": ""
        },
        "source": "GIT"
      },
      "environment_key": "default",
      "timeout_seconds": 7200,
      "max_retries": 1,
      "min_retry_interval_millis": 60000
    },
    {
      "task_key": "refresh_experiment",
      "description": "Measure full recompute versus incremental MERGE and persist the timing rows.",
      "depends_on": [
        {
          "task_key": "silver_to_gold"
        }
      ],
      "notebook_task": {
        "notebook_path": "data/cloud/databricks/notebooks/03_refresh_experiment",
        "base_parameters": {
          "silver_table": "main.default.silver_flight_state",
          "gold_congestion_table": "main.default.gold_airport_congestion",
          "experiment_results_table": "main.default.refresh_experiment_results",
          "sizes": "10000,50000,200000",
          "inc_pct": "0.10"
        },
        "source": "GIT"
      },
      "environment_key": "default",
      "timeout_seconds": 7200,
      "max_retries": 1,
      "min_retry_interval_millis": 60000
    }
  ],
  "environments": [
    {
      "environment_key": "default",
      "spec": {
        "environment_version": "2",
        "dependencies": [
          "h3==3.7.7",
          "geohash2==1.1"
        ]
      }
    }
  ],
  "git_source": {
    "git_url": "https://github.com/akshitanchan/flight-telemetry",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "max_concurrent_runs": 1,
  "tags": {
    "project": "flight-telemetry",
    "wave": "W4.3",
    "task": "ds-07",
    "layer": "medallion",
    "compute": "serverless"
  },
  "format": "MULTI_TASK"
}
